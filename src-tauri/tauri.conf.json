{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenHarness",
  "version": "0.1.0",
  "identifier": "dev.openharness.app",
  "build": {
    "beforeDevCommand": "npm run build --prefix ../frontend",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "npm run build --prefix ../frontend",
    "frontendDist": "../frontend/out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenHarness",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/openharness-sidecar"],
    "resources": ["resources/default-agile.oharness"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
